{
  "info": {
    "name": "Sirji Homecare API",
    "description": "Core customer, authentication, catalogue, order, feedback, and administrator workflows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "adminEmail", "value": "" },
    { "key": "adminPassword", "value": "" },
    { "key": "productId", "value": "11111111-1111-4111-8111-111111111111" },
    { "key": "orderNumber", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "customerPhone", "value": "+91 9876543210" }
  ],
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "List products",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/products" }
        },
        {
          "name": "Create order request",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Order request created', () => pm.response.to.have.status(201));",
            "const body = pm.response.json();",
            "pm.collectionVariables.set('orderNumber', body.orderNumber);",
            "pm.collectionVariables.set('orderId', body.id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"customerName\": \"Sample Customer\",\n  \"customerPhone\": \"{{customerPhone}}\",\n  \"deliveryAddress\": \"Replace with your delivery address\",\n  \"latitude\": 12.9716,\n  \"longitude\": 77.5946,\n  \"items\": [{ \"productId\": \"{{productId}}\", \"quantity\": 2 }]\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/orders"
          }
        },
        {
          "name": "Track order request",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/orders/track?orderNumber={{orderNumber}}&phone={{customerPhone}}", "host": ["{{baseUrl}}"], "path": ["api", "orders", "track"], "query": [ { "key": "orderNumber", "value": "{{orderNumber}}" }, { "key": "phone", "value": "{{customerPhone}}" } ] }
          }
        },
        {
          "name": "Submit feedback",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"customerName\": \"Sample Customer\",\n  \"email\": \"customer@example.com\",\n  \"rating\": 5,\n  \"message\": \"The order request process was clear.\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/feedback"
          }
        },
        {
          "name": "Admin login",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Login succeeded', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('token', pm.response.json().token);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Administrator",
      "item": [
        { "name": "List orders", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/orders?status=PENDING_APPROVAL" } },
        {
          "name": "Approve order",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"approved\": true,\n  \"notes\": \"Confirmed with customer\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/admin/orders/{{orderId}}/approval"
          }
        },
        { "name": "List site settings", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/settings" } },
        {
          "name": "Update bulk quantity threshold",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"value\": \"50\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/admin/settings/bulk.quantity.threshold"
          }
        },
        { "name": "List service branches", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/branches" } }
      ]
    }
  ]
}
